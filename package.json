{
  "name": "cervejaria-rodada-platform",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "dev": "next dev",
    "dev:site": "pnpm --filter @rodada/site dev",
    "dev:admin": "pnpm --filter @rodada/admin dev",
    "build": "next build",
    "build:all": "pnpm -r build",
    "typecheck": "tsc --noEmit",
    "typecheck:all": "pnpm -r typecheck",
    "build:site": "next build",
    "typecheck:site": "tsc --noEmit",
    "build:admin": "npm --prefix apps/admin run build",
    "typecheck:admin": "npm --prefix apps/admin run typecheck",
    "verify": "npm run typecheck:site && npm run build:site && npm run typecheck:admin && npm run build:admin",
    "lint": "npm run lint:site && npm run lint:admin",
    "lint:site": "eslint app components lib --max-warnings=0",
    "lint:admin": "eslint apps/admin --max-warnings=0"
  },
  "dependencies": {
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "@supabase/supabase-js": "2.57.4",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.9.3",
    "eslint": "9.39.1",
    "eslint-config-next": "16.3.8"
  }
}
